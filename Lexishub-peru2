    <!-- PRESENTACIÓN -->
    <section id="presentacion">
        <div class="section-header">
            <h2>1. Presentación de la Propuesta</h2>
            <div></div>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="icon-box"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <h3>La Problemática Crítica</h3>
                <p>En el Perú, la falta de interconexión digital eficiente entre el Ministerio Público, RENIEC y OSIPTEL genera pérdidas irreversibles por fraudes como la suplantación de identidad ("La Estafa Del DNI Duplicado").</p>
            </div>
            <div class="card">
                <div class="icon-box"><i class="fa-solid fa-shield-halved"></i></div>
                <h3>La Solución LexisHub</h3>
                <p>Proponemos articular <strong>LegalTech</strong> (Onomondo y CURIA) para prevención biométrica previa, y <strong>JusticeTech</strong> (CyberArk y JUSTINA) para rediseñar la interconexión entre el Poder Judicial y entidades estatales.</p>
            </div>
        </div>
    </section>

    <!-- HUB TEL AVIV -->
    <section id="telaviv">
        <div class="section-header">
            <h2>2. Factores de Éxito: Hub Tel Aviv</h2>
            <div></div>
        </div>
        <div class="grid-2" style="margin-bottom: 2rem;">
            <div class="card">
                <div class="icon-box"><i class="fa-solid fa-user-shield"></i></div>
                <h3>Formación desde la Defensa</h3>
                <p>Capacitación tecnológica avanzada en el servicio militar que luego se traslada al ecosistema emprendedor civil.</p>
            </div>
            <div class="card">
                <div class="icon-box"><i class="fa-solid fa-lightbulb"></i></div>
                <h3>Cultura de Innovación</h3>
                <p>Cuestionar y cometer errores se asume como aprendizaje continuo, impulsando soluciones audaces.</p>
            </div>
        </div>

        <h3 style="margin: 2rem 0 1rem 0; color: var(--primary);">Startups Destacadas</h3>
        <div class="grid-3">
            <div class="card">
                <h3>CyberArk</h3>
                <p><small style="color: var(--accent); font-weight: 600;">Ciberseguridad</small></p>
                <p>Protege accesos privilegiados en instituciones mediante licenciamiento anual.</p>
            </div>
            <div class="card">
                <h3>Onomondo</h3>
                <p><small style="color: var(--accent); font-weight: 600;">Verificación Biométrica</small></p>
                <p>Confirma identidad en tiempo real sin revelar contraseñas ni datos sensibles.</p>
            </div>
            <div class="card">
                <h3>Mobileye</h3>
                <p><small style="color: var(--accent); font-weight: 600;">Inteligencia Artificial</small></p>
                <p>Tecnología predictiva para prevención de accidentes integrada en vehículos.</p>
            </div>
        </div>
    </section>

    <!-- ESPACIO PARA EL DIAGRAMA DE TU COMPAÑERA -->
    <section id="diagrama">
        <div class="section-header">
            <h2>3. Diagrama del Sistema / Flujograma</h2>
            <div></div>
        </div>
        <div class="diagram-section">
            <i class="fa-solid fa-diagram-project" style="font-size: 3rem; color: var(--accent); margin-bottom: 1rem;"></i>
            <h3>Diagrama del Ecosistema de Justicia Digital</h3>
            <p style="color: var(--text-muted);">A continuación se muestra el esquema interactivo diseñado para la articulación institucional en el Perú.</p>
            
            <!-- Aaquí irá la imagen del diagrama de tu compañera -->
            <img src="diagrama.png" alt="Diagrama de la compañera" class="diagram-placeholder" onerror="this.src='https://via.placeholder.com/800x400?text=Sube+aquí+la+imagen+del+diagrama+(diagrama.png)';">
            
            <p style="margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted);">
                <em>Nota: Para mostrar la foto de tu compañera, sube la imagen a tu GitHub con el nombre <strong>diagrama.png</strong>.</em>
            </p>
        </div>
